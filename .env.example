# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LinkedIn session cookie (optional - can also be set in the UI)
LINKEDIN_COOKIE=your_li_at_cookie_value_here

# Server port (optional, default: 3001)
PORT=3001

# Claude model for profile extraction (optional, default: claude-haiku-4-5)
ANTHROPIC_MODEL_SCRAPING=claude-haiku-4-5

# Claude model for message generation (optional, default: claude-opus-4-7)
ANTHROPIC_MODEL_MESSAGING=claude-opus-4-7

# Debug mode - set to true to show browser window during scraping (optional)
DEBUG_MODE=false
